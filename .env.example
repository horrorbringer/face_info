DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
# Local Docker development only. Set False only behind a real HTTPS reverse proxy.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# In production with HTTPS, add your public origin: e.g. https://attendance.school.edu
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DATABASE_URL=postgresql://faceinfo:change-me@db:5432/faceinfo
# Directory containing an approved InsightFace-compatible ONNX model pack; leave blank to disable face scans.
FACE_MODEL_PATH=
MATCH_THRESHOLD=0.5
LATE_THRESHOLD_MINUTES=15
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Optional Telegram bot token for absence alerts
TELEGRAM_BOT_TOKEN=

# Anti-Cheat & Security Hardening
DYNAMIC_QR_INTERVAL_SECONDS=20
# Comma-separated list of allowed CIDR IP subnets for attendance check-ins (e.g. 192.168.1.0/24,10.0.0.0/16). Leave blank to allow any network.
ATTENDANCE_ALLOWED_SUBNETS=

